# =============================================================================
# HostOps AI — variáveis de ambiente (EXEMPLO)
# Copie para ".env" e substitua TODOS os valores. Nada aqui é uma credencial real.
# Nunca faça commit do arquivo .env.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Banco de dados (MariaDB) -------------------------------------------------
MARIADB_ROOT_PASSWORD=troque-esta-senha-root
MARIADB_DATABASE=hostops
MARIADB_USER=hostops
MARIADB_PASSWORD=troque-esta-senha
DATABASE_URL=mysql://hostops:troque-esta-senha@localhost:3306/hostops
# Banco exclusivo dos testes de integração (é recriado a cada execução!)
DATABASE_URL_TEST=mysql://hostops:troque-esta-senha@localhost:3306/hostops_test

# --- Redis / filas --------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API ------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# URL pública do painel (usada em CORS, cookies e redirecionamentos OAuth)
WEB_URL=http://localhost:3000
# URL da API vista pelo servidor Next.js (rewrites /api -> API)
API_INTERNAL_URL=http://localhost:3001

# Gere com: openssl rand -base64 48
JWT_SECRET=substitua-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
# Chave AES-256-GCM para tokens/segredos em repouso. Gere com: openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Diretório local para fotos de limpeza
STORAGE_DIR=./storage

# --- Google Gemini --------------------------------------------------------------
# Sem chave, o agente NÃO responde: as conversas são encaminhadas para atendimento humano.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Horas antes do check-in em que Wi-Fi e instruções de acesso podem ser liberados
AI_ACCESS_RELEASE_HOURS=48

# --- WhatsApp Business Cloud API ------------------------------------------------
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# Nome do template aprovado usado para avisar diaristas (opcional)
WHATSAPP_TEMPLATE_CLEANING_ASSIGNED=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# --- Google Calendar (OAuth) ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar

# --- Seeds (dados fictícios) ----------------------------------------------------
SEED_DEMO_PASSWORD=HostOps@Demo2026

# --- Produção (docker-compose.prod.yml) -----------------------------------------
# Domínio público do painel, sem https:// (o Caddy emite o certificado automaticamente).
# Em produção defina também: NODE_ENV=production, WEB_URL=https://<DOMAIN>
# e GOOGLE_REDIRECT_URI=https://<DOMAIN>/api/v1/integrations/google/callback
DOMAIN=
